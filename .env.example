# Copy this file to .env.local and fill in the values for your deployment.

# Required Supabase configuration for production
# Vercel deployments with file uploads require Supabase storage,
# so set these values before deploying if you need uploads in production.
# Wedding data and admin flows can still run locally without these keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional backward compatible key support
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Supabase database connection for local scripts and migrations
SUPABASE_DB_URL=

# Authentication secrets (required in production)
AUTH_SECRET=change-me-in-production
NEXTAUTH_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production

# Admin and fallback credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Default demo accounts (optional, but useful for local/demo environments)
DEMO_COUPLE_USERNAME=ahmed-sara-account
DEMO_COUPLE_PASSWORD=wedding123
DEMO_USER_USERNAME=demo-user
DEMO_USER_PASSWORD=demo-password

# Optional local data path for fallback storage
WEDDING_DATA_DIR=

# Optional SMTP settings for sending email notifications or admin credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=No Reply <no-reply@example.com>

